{
  "name": "zhongsheng-luo-personal-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-content.mjs && next build --webpack",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/validate-content.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
